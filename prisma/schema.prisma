generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  TRIAL
  DISABLED
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
  ACTIVE
  PAUSED
  DONE
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  name         String?
  passwordHash String?
  roleId       String
  role         Role              @relation(fields: [roleId], references: [id])
  status       UserStatus        @default(TRIAL)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  lastLoginAt  DateTime?
  lastSeenAt   DateTime?
  entitlements UserEntitlement[]
  sessions     Session[]

  // Telegram integration
  telegramChatId     String?   @unique
  telegramVerifyCode String?   @unique

  // Project management relations
  projectMembers     ProjectMember[]
  assignedTasks      Task[]
  chatMessages       ChatMessage[]
  curatorSubmissions CuratorSubmission[]
  activityLogs       ActivityLog[]

  // LMS relations
  lessonProgress     LessonProgress[]
  courseEnrollments  CourseEnrollment[]

  // Agent audit relations
  agentAuditLogs     AgentAuditLog[]

  // Vault Ownership & KPI relations
  ownedFolders        VaultFolder[]            @relation("FolderOwnership")
  ownedEvents         AccountGenerationEvent[] @relation("EventOwnerUser")
  setEvents           AccountGenerationEvent[] @relation("EventSetByUser")
  functionAssignments FunctionAssignment[]
  kpiGoals            KpiGoal[]
  activityEvents      ActivityEvent[]          @relation("UserActivityEvent")
  warmupEnrollments   WarmupEnrollment[]       @relation("WarmerEnrollment")
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique // SHA-256 of the opaque cookie token — never store the raw token
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  lastSeenAt     DateTime  @default(now())
  lastExtendedAt DateTime  @default(now()) // last rolling-expiry extension (throttle marker)
  ipAddress      String?
  userAgent      String?
  revokedAt      DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

model LoginEvent {
  id                String   @id @default(uuid())
  userId            String?
  attemptedUsername String?
  success           Boolean
  createdAt         DateTime @default(now())
  ipAddress         String?
  userAgent         String?

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Role {
  id       String        @id @default(uuid())
  key      String        @unique
  label    String
  users    User[]
  defaults RoleDefault[]
}

model RoleDefault {
  id      String @id @default(uuid())
  roleId  String
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  toolKey String

  @@unique([roleId, toolKey])
}

model UserEntitlement {
  id      String  @id @default(uuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolKey String
  granted Boolean

  @@unique([userId, toolKey])
}

model Campaign {
  id                  String         @id @default(uuid())
  slug                String         @unique
  title               String
  name                String?
  type                String         @default("other") // "political" | "music" | "other"
  createdBy           String?
  description         String
  brief               String
  deliverableFormat   String         @default("VIDEO")
  deliverableCount    Int            @default(1)
  requiredHashtags    String[]
  requiredMentions    String[]
  payoutPerPostCents  Int
  currency            String         @default("USD")
  totalBudgetCents    Int
  maxCreators         Int
  applicationDeadline DateTime
  deliveryDeadline    DateTime
  minFollowerCount    Int            @default(0)
  nicheTags           String[]
  ageMinimum          Int            @default(18)
  status              CampaignStatus @default(DRAFT)
  approvedByAdminAt   DateTime?
  coverImageUrl       String?
  exampleVideos       String[]

  // Auto-posting stats (Drive pipeline, matched via leading "(title)" in file name)
  postedCount           Int            @default(0)
  failedCount           Int            @default(0)
  exportedCount         Int            @default(0)

  // Posting priority: when priorityQuota is set, this campaign's AVAILABLE jobs
  // are claimed before all others until priorityUsed reaches the quota (auto-off).
  priorityQuota         Int?
  priorityUsed          Int            @default(0)

  // Goal / calculator parameters
  targetViews            Int         @default(0)
  accountsCount          Int         @default(0)
  avgViewsPerVideo       Int         @default(0)
  videosPerAccountPerDay Int         @default(0)
  
  // Rich info content
  infoContent            String?     @db.Text

  // Auto-post caption pools (resolved per post via PostJob.campaignId)
  fixedTexts             String[]      @default([]) // Pool of fixed caption texts — one picked at random per auto-post
  descTags               String?                    // Comma-separated hashtag pool — overrides the section pool when set
  descTagCount           Int           @default(3)  // How many tags to randomly select per post
  
  // Resources
  resources              CampaignResource[]
  clipFolders            ClipFolder[]

  // Project management relations
  projects               Project[]
  curatorSubmissions     CuratorSubmission[]
  
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  multiplierGroups    MultiplierGroup[]
  activityEvents      ActivityEvent[]
  events              CampaignEvent[]
}

// Durable per-campaign event log (exports, post successes/failures).
// Survives deletion of MultiplierGroups/MultiplierOutputs so campaign stats persist.
model CampaignEvent {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type       String   // "export" | "post_success" | "post_failed"
  count      Int      @default(1)
  meta       Json     @default("{}") // e.g. { accountUsername, driveFileName, groupName, jobId }
  createdAt  DateTime @default(now())
  @@index([campaignId, type, createdAt])
}

model CampaignResource {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  label      String
  url        String
  type       String   // "link" | "file" | "reference"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// Multi-Account Management Panel
// ═══════════════════════════════════════════════════════════════════════════════

model AccountSection {
  id                   String         @id @default(uuid())
  name                 String         @unique
  slug                 String         @unique
  color                String         @default("#8b5cf6")
  icon                 String?
  descTags             String?        // Comma-separated tag pool (e.g. "#music,#viral,#fyp")
  descTagCount         Int            @default(3)     // How many tags to randomly select per video
  isActive             Boolean        @default(true)  // Master toggle
  sortOrder            Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  accounts             ManagedAccount[]
  clipFolders          ClipFolder[]
}

model ManagedAccount {
  id                    String       @id @default(uuid())
  sectionId             String
  section               AccountSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // TikTok identity (from Login Kit OAuth — optional when using PostPeer)
  tiktokOpenId          String?      @unique
  tiktokUnionId         String?
  tiktokUsername        String
  tiktokDisplayName     String       @default("")
  tiktokAvatarUrl       String       @default("")
  tiktokAccessToken     String       @default("")
  tiktokRefreshToken    String       @default("")
  tokenExpiresAt        DateTime     @default(now())
  refreshTokenExpiresAt DateTime     @default(now())
  tiktokScopes          String       @default("")

  // Profile stats (synced periodically)
  followerCount         Int          @default(0)
  followingCount        Int          @default(0)
  likesCount            Int          @default(0)
  videoCount            Int          @default(0)
  isVerified            Boolean      @default(false)
  statsUpdatedAt        DateTime?

  // Google Drive link
  // driveFolderId is the OUTPUT / posting folder: finished videos are delivered here
  // and the auto-posting pipeline posts from it. (Music niche: do NOT add a separate
  // outputDriveFolderId — this column is the output folder.)
  driveFolderId         String?
  driveFolderName       String?
  driveConnected        Boolean      @default(false)
  googleAccessToken     String?
  googleRefreshToken    String?
  googleTokenExpiresAt  DateTime?

  // Music niche: INPUT folder — background source clips are read from here
  inputDriveFolderId    String?
  lastDriveSyncAt       DateTime?

  // PostPeer integration
  postpeerAccountId     String?
  color                 String       @default("zinc")
  colorId               String?
  colorRef              AccountColor?  @relation(fields: [colorId], references: [id], onDelete: SetNull)

  // Scheduling config
  postTimeHour          Int          @default(12)
  postTimeMinute        Int          @default(0)
  postTimezone          String       @default("UTC")
  postDays              String       @default("1,2,3,4,5,6,7")
  postMode              String       @default("DIRECT")
  // Multiple time slots per day, stored as CSV "HH:MM" e.g. "09:00,14:30,20:00"
  postTimeSlots         String       @default("12:00")
  isActive              Boolean      @default(true)

  // Health and Token status tracking
  connectionState       String       @default("healthy") // healthy | needs_reauth | not_found | checking
  lastCheckedAt         DateTime?
  lastError             String?

  connectedAt           DateTime     @default(now())
  revokedAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  scheduledPosts        ScheduledPost[]
  postJobs              PostJob[]
  dailyAnalytics        AccountDailyAnalytics[]
  sourcingNiches        SourcingNicheAccount[]
  genreConfigs          AccountGenreConfig[]
  backgroundVideos      AccountBackgroundVideo[]
  genreBatchItems       GenreBatchItem[]
  clipMixerItems        ClipMixerItem[]
  sheetCells            SheetCell[]
  warmupEnrollment      WarmupEnrollment?
  driveFiles            DriveFile[]

  @@index([sectionId])
}

model AccountColor {
  id               String           @id @default(uuid())
  color            String           // swatch hex code or key (e.g. "green", "#10b981")
  meaning          String           // a text label, e.g. "Healthy", "Banned", "Warming"
  defaultPostCount Int              @default(1)
  order            Int              @default(0)
  accounts         ManagedAccount[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

enum PostStatus {
  QUEUED
  DOWNLOADING
  UPLOADING
  PROCESSING
  PUBLISHED
  FAILED
  SKIPPED
  CLAIMED
  PENDING_DELETION
  DELETED
}

model PostJob {
  id              String         @id @default(uuid())
  driveFileId     String
  driveFileName   String?
  accountId       String
  account         ManagedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  state           String         @default("AVAILABLE") // AVAILABLE | CLAIMED | UPLOADING | PUBLISHED | PENDING_DELETION | DELETED | FAILED
  attempts        Int            @default(0)
  lockedAt        DateTime?
  lockedBy        String?
  tiktokPublishId String?
  tiktokPostId    String?
  tiktokPostUrl   String?
  failureReason   String?
  publishedAt     DateTime?
  deleteAfter     DateTime?
  campaignId      String? // plain column (no relation) — matched from leading "(Campaign Title)" in Drive file name
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([driveFileId, accountId])
}

model ScheduledPost {
  id              String         @id @default(uuid())
  accountId       String
  account         ManagedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Source
  driveFileId     String?
  driveFileName   String?
  videoUrl        String?

  // Post content
  caption         String         @default("")
  hashtags        String?

  // Schedule
  scheduledFor    DateTime
  status          PostStatus     @default(QUEUED)

  // TikTok result
  tiktokPublishId String?
  tiktokVideoId   String?
  tiktokPostUrl   String?
  publishedAt     DateTime?
  errorMessage    String?

  // Post-publish metrics
  viewCount       BigInt         @default(0)
  likeCount       BigInt         @default(0)
  commentCount    BigInt         @default(0)
  shareCount      BigInt         @default(0)
  metricsUpdatedAt DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model AccountDailyAnalytics {
  id             String         @id @default(uuid())
  accountId      String
  account        ManagedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date           DateTime
  followerCount  Int            @default(0)
  followingCount Int            @default(0)
  likesCount     Int            @default(0)
  videoCount     Int            @default(0)
  postsToday     Int            @default(0)
  totalViews     BigInt         @default(0)
  totalLikes     BigInt         @default(0)

  @@unique([accountId, date])
}

model GoogleCredential {
  id             String   @id @default(uuid())
  adminUserId    String   @unique
  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// YouTube Video Sourcing (independent of Account Groups)
// ═══════════════════════════════════════════════════════════════════════════════

enum YouTubeSourceType {
  CHANNEL
  PLAYLIST
}

enum SourcedVideoStatus {
  NEW
  DOWNLOADED
  CLIPPED
  SKIPPED
}

/// A content topic used for video sourcing — independent of the accounts hierarchy.
model SourcingNiche {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  color       String   @default("#ef4444")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts    SourcingNicheAccount[]
  sources     YouTubeSource[]
  videos      YouTubeSourcedVideo[]
}

/// Join table: which ManagedAccounts belong to which SourcingNiche.
model SourcingNicheAccount {
  nicheId   String
  niche     SourcingNiche  @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  accountId String
  account   ManagedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  addedAt   DateTime       @default(now())

  @@id([nicheId, accountId])
}

model YouTubeSource {
  id               String            @id @default(uuid())
  nicheId          String
  niche            SourcingNiche     @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  type             YouTubeSourceType
  youtubeId        String
  url              String
  title            String            @default("")
  thumbnailUrl     String?
  subscriberCount  Int?
  maxVideosPerFetch Int              @default(10)
  isActive         Boolean           @default(true)
  lastFetchedAt    DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  videos           YouTubeSourcedVideo[]

  @@unique([nicheId, youtubeId])
}

model YouTubeSourcedVideo {
  id             String             @id @default(uuid())
  sourceId       String
  source         YouTubeSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  nicheId        String
  niche          SourcingNiche      @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  youtubeVideoId String
  title          String
  description    String?
  thumbnailUrl   String
  channelTitle   String
  publishedAt    DateTime
  duration       String             @default("PT0S")
  viewCount      BigInt             @default(0)
  likeCount      BigInt             @default(0)
  commentCount   BigInt             @default(0)
  status         SourcedVideoStatus @default(NEW)
  downloadUrl    String?
  summary        String?
  discoveredAt   DateTime           @default(now())
  fetchedAt      DateTime           @default(now())

  @@unique([sourceId, youtubeVideoId])
}

enum GenreBatchStatus {
  DRAFT
  QUOTES_GENERATING
  QUOTES_REVIEW
  RENDERING
  COMPLETED
  FAILED
}

enum GenreBatchItemStatus {
  PENDING
  GENERATED
  CONFIRMED
  RENDERING
  RENDERED
  UPLOADED
  FAILED
}

model Track {
  id              String                 @id @default(uuid())
  title           String
  artist          String?
  fileUrl         String
  duration        Float
  defaultStart    Float                  @default(0.0)
  defaultDuration Float                  @default(7.0)
  genre           String?
  musician        String?
  campaignOn      Boolean                @default(false)
  campaignActiveAt DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  batchItems      GenreBatchItem[]

  isLyrical           Boolean                @default(false)
  lyricalTranscription String?                // JSON array of word-level aligned timestamps
  lyricalTemplates    TrackLyricalTemplate[]
  clipMixerBatches    ClipMixerBatch[]
  lyricGenerations    LyricGeneration[]

  // Music niche (Video Factory) fields
  audioRef      String?             // local path or R2 key
  lrcData       Json?               // synced lyric lines [{t, text}]
  trimStart     Float               @default(0)
  trimEnd       Float?
  maxReuse      Int?                // null = unlimited
  createdBy     String?
  items         FactoryBatchItem[]
}

model TrackLyricalTemplate {
  id              String           @id @default(uuid())
  trackId         String
  track           Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  templateName    String           // e.g. "Neon Rainbow", "Vibrant Yellow"
  fontFamily      String           @default("Montserrat-Black")
  fontSize        Int              @default(48)
  activeColor     String           @default("multi")
  strokeWidth     Int              @default(5)
  strokeColor     String           @default("#000000")
  positionY       Float            @default(0.75)
  colorFilter     String           @default("none")
  vignette        String           @default("none")
  particleFx      String           @default("none")
  mirrorBg        Boolean          @default(false)
  bgSpeed         Float            @default(1.0)
  animationMode   String           @default("highlight")  // "highlight" = existing, "word_builder" = progressive append
  bgColor         String?          // Solid background color hex (e.g. "#D4A017"). When set, replaces video bg
  textColor       String?          // Text color override (e.g. "#000000"). Defaults to white if null
  textAlign       String           @default("center")     // "left" | "center" | "right"
  wordSpacing     String           @default("normal")     // "normal" | "wide" | "extra_wide"
  letterSpacing   Int              @default(0)            // Extra letter spacing in pixels
  aspectRatio     String           @default("9:16")
  overlayVideoUrl String?          // Local transparent .mov video overlay file URL
  previewImageUrl String?          // Local transparent preview PNG image file URL
  muteAudio       Boolean          @default(false)  // Toggle to mute audio in composition
  bgOpacity       Float            @default(1.0)
  lofiFactor      Int              @default(1)
  textMargin      Int              @default(50)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  savedStyleId    String?
  savedStyle      SavedStyle?      @relation(fields: [savedStyleId], references: [id], onDelete: SetNull)

  batchItems      GenreBatchItem[]
  clipMixerBatches ClipMixerBatch[]
  clipMixerItems  ClipMixerItem[]

  @@unique([trackId, templateName])
}

model AccountGenreConfig {
  id             String         @id @default(uuid())
  accountId      String
  account        ManagedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  genre          String         @default("quote")
  themeText      String
  fontFamily     String         @default("Outfit-Bold")
  fontSize       Int            @default(44)
  fontColor      String         @default("#FFFFFF")
  textCase       String         @default("UPPERCASE")
  boxColor       String         @default("none")
  shadowColor    String         @default("black@0.6")
  lineSpacing    Int            @default(10)
  curveText      Boolean        @default(false)
  curvature      Int            @default(30)
  positionY      Int            @default(50)
  textMargin     Int            @default(50)
  strokeEnabled  Boolean        @default(false)
  strokeColor    String         @default("#000000")
  strokeWidth    Int            @default(0)
  letterSpacing  Int            @default(0)
  colorFilter    String         @default("none")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  savedStyleId   String?
  savedStyle     SavedStyle?    @relation(fields: [savedStyleId], references: [id], onDelete: SetNull)

  @@unique([accountId, genre])
}

model AccountBackgroundVideo {
  id        String         @id @default(uuid())
  accountId String
  account   ManagedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  genre     String         @default("quote")
  videoUrl  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model GenreBatch {
  id              String           @id @default(uuid())
  genre           String           @default("quote")
  status          GenreBatchStatus @default(DRAFT)
  totalPosts      Int
  postsPerAccount Int
  audioReuseMax   Int              @default(2)
  videoLength     Float            @default(7.0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           GenreBatchItem[]
}

model GenreBatchItem {
  id                  String               @id @default(uuid())
  batchId             String
  batch               GenreBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  accountId           String
  account             ManagedAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  quoteText           String
  quoteAuthor         String?
  trackId             String
  track               Track                @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackStart          Float
  trackEnd            Float?
  backgroundVideoUrl  String
  renderedVideoUrl    String?
  driveFileId         String?
  muteAudio           Boolean              @default(false)
  status              GenreBatchItemStatus @default(PENDING)
  errorMessage        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  lyricalTemplateId   String?
  lyricalTemplate     TrackLyricalTemplate? @relation(fields: [lyricalTemplateId], references: [id], onDelete: SetNull)
  savedStyleId        String?
  savedStyle          SavedStyle?           @relation(fields: [savedStyleId], references: [id], onDelete: SetNull)
  parameterTweaks     String?               @db.Text
}

// ═══════════════════════════════════════════════════════════════════════════════
// Video Multiplier — Bulk text overlay generation
// ═══════════════════════════════════════════════════════════════════════════════

enum MultiplierBatchStatus {
  UPLOADING
  READY
  RENDERING
  COMPLETED
  FAILED
}

enum MultiplierItemStatus {
  PENDING
  RENDERING
  RENDERED
  FAILED
}

model MultiplierBatch {
  id              String                @id @default(uuid())
  name            String                @default("")
  sourceVideoUrl  String                // Uploaded base video path in public/uploads/
  totalItems      Int                   @default(0)
  status          MultiplierBatchStatus @default(UPLOADING)

  // Text overlay styling
  fontFamily      String                @default("Outfit-Bold")
  fontSize        Int                   @default(42)
  fontColor       String                @default("#FFFFFF")
  textCase        String                @default("UPPERCASE")
  bgStripColor    String                @default("#000000")
  bgStripOpacity  Float                 @default(1.0)
  textPosition    String                @default("TOP")       // TOP | BOTTOM (legacy, use positionYPercent)
  stripPaddingY   Int                   @default(20)
  positionYPercent Int                  @default(5)           // 0=top, 100=bottom
  marginX         Int                   @default(0)           // Horizontal margin from edges (px)
  borderRadius    Int                   @default(12)          // Corner radius in px
  hookDuration    Int                   @default(5)           // Hook text overlay duration in seconds

  // Google Drive export
  driveFolderId     String?               // assigned Google Drive folder ID
  driveFolderName   String?               // folder display name
  driveExportStatus String?               // EXPORTING | EXPORTED | FAILED | null

  errorMessage    String?
  googleEmail     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  items           MultiplierItem[]
}

model MultiplierItem {
  id               String               @id @default(uuid())
  batchId          String
  batch            MultiplierBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  hookText         String
  renderedVideoUrl String?
  status           MultiplierItemStatus @default(PENDING)
  errorMessage     String?
  templateId       String?              // which design template was used
  driveFolderId    String?              // per-item Drive folder override
  driveFolderName  String?              // per-item folder display name
  googleEmail      String?              // per-item Google Drive account email
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

// ─── Multiplier Design Templates ─────────────────────────────────────────────

model MultiplierTemplate {
  id               String   @id @default(uuid())
  name             String

  // Typography
  fontFamily       String   @default("Outfit-Bold")
  fontSize         Int      @default(42)
  fontColor        String   @default("#FFFFFF")
  textCase         String   @default("UPPERCASE")
  letterSpacing    Float    @default(1.0)
  lineHeight       Float    @default(1.4)

  // Text Effects — Stroke
  strokeEnabled    Boolean  @default(false)
  strokeColor      String   @default("#000000")
  strokeWidth      Int      @default(2)

  // Text Effects — Shadow
  shadowEnabled    Boolean  @default(false)
  shadowColor      String   @default("#000000")
  shadowX          Int      @default(2)
  shadowY          Int      @default(2)

  // Text Effects — Neon Glow
  glowEnabled      Boolean  @default(false)
  glowColor        String   @default("#FF00FF")
  glowIntensity    Int      @default(2)

  // Background Strip
  bgStripColor     String   @default("#000000")
  bgStripOpacity   Float    @default(1.0)
  stripWidthMode   String   @default("FULL")
  stripWidthPercent Int     @default(100)
  borderRadius     Int      @default(12)

  stripBorderEnabled Boolean @default(false)
  stripBorderColor   String  @default("#FFFFFF")
  stripBorderWidth   Int     @default(1)

  stripShadowEnabled Boolean @default(false)
  stripShadowColor   String  @default("#000000")
  stripShadowOffset  Int     @default(4)

  // Layout
  positionYPercent Int      @default(5)
  marginX          Int      @default(0)
  paddingY         Int      @default(20)
  paddingX         Int      @default(20)
  textAlign        String   @default("CENTER")

  // ── Advanced: Gradient Strip Background ──
  stripGradientEnabled  Boolean  @default(false)
  stripGradientColor2   String   @default("#333333")
  stripGradientAngle    Int      @default(90)       // 0=top→bottom, 90=left→right

  // ── Advanced: Strip Shape Mode ──
  stripShape            String   @default("FULL")   // FULL | PILL | NONE

  // ── Advanced: Entrance Animation ──
  animationType         String   @default("NONE")   // NONE | FADE_IN | SLIDE_UP | SCALE_IN
  animationDuration     Float    @default(0.5)

  // ── Advanced: Backdrop Blur (behind strip) ──
  backdropBlurEnabled   Boolean  @default(false)
  backdropBlurRadius    Int      @default(10)

  // ── Advanced: Text Gradient (multi-color text via SVG) ──
  textGradientEnabled   Boolean  @default(false)
  textGradientColor1    String   @default("#FFFFFF")
  textGradientColor2    String   @default("#00FFFF")
  textGradientAngle     Int      @default(180)

  // ── Advanced: Double Text (outline + fill layering) ──
  doubleTextEnabled     Boolean  @default(false)
  doubleTextOutlineColor String  @default("#000000")
  doubleTextOutlineWidth Int     @default(4)

  // ── Preset Origin ──
  isPreset              Boolean  @default(false)
  presetCategory        String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Multiplier Group Models ──────────────────────────────────────────────────

model MultiplierGroup {
  id              String                    @id @default(uuid())
  name            String
  campaignId      String?
  campaign        Campaign?                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  transcript      String?                   @db.Text
  transcriptStatus String                    @default("PENDING") // PENDING | TRANSCRIBING | TRANSCRIBED | FAILED
  styleId         String                    // template preset key or ID
  mappingMode     String                    @default("each")    // each | distribute
  settings        Json                      @default("{}")      // holds custom visual overrides
  status          String                    @default("DRAFT")   // DRAFT | QUEUED | RENDERING | COMPLETED | FAILED
  errorMessage    String?
  createdBy       String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  variations      MultiplierGroupVariation[]
  hooks           MultiplierHook[]
  outputs         MultiplierOutput[]
}

model MultiplierGroupVariation {
  id        String             @id @default(uuid())
  groupId   String
  group     MultiplierGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  videoRef  String             // File path in public/uploads/
  order     Int                @default(0)
  createdAt DateTime           @default(now())
  outputs   MultiplierOutput[]
}

model MultiplierHook {
  id        String             @id @default(uuid())
  groupId   String
  group     MultiplierGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  text      String
  source    String             @default("manual") // ai | csv | manual
  order     Int                @default(0)
  createdAt DateTime           @default(now())
  outputs   MultiplierOutput[]
}

model MultiplierOutput {
  id            String                    @id @default(uuid())
  groupId       String
  group         MultiplierGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  variationId   String
  variation     MultiplierGroupVariation  @relation(fields: [variationId], references: [id], onDelete: Cascade)
  hookId        String
  hook          MultiplierHook            @relation(fields: [hookId], references: [id], onDelete: Cascade)
  status        String                    @default("PENDING") // PENDING | RENDERING | COMPLETED | FAILED
  outputRef     String?                   // path to completed MP4 in public/uploads/
  driveFolderId String?
  driveFolderName String?
  googleEmail     String?
  errorMessage  String?
  exportedAt                 DateTime?                 // set when included in a Smart Download archive
  exportStatus               String                    @default("not_exported") // not_exported | exporting | exported
  exportDestinationFolderId  String?
  exportDestinationFolderName String?
  exportAssignments          SmartExportAssignment[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
}

model SmartExportJob {
  id          String                  @id @default(uuid())
  groupIds    String[]
  status      String                  @default("pending") // pending | uploading | done | failed
  days        Int                     @default(1)
  createdBy   String?
  createdAt   DateTime                @default(now())
  summary     Json                    @default("{}")
  assignments SmartExportAssignment[]
}

model SmartExportAssignment {
  id            String           @id @default(uuid())
  jobId         String
  job           SmartExportJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  videoId       String
  video         MultiplierOutput @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sourceGroupId String
  driveFolderId String
  status        String           @default("pending") // pending | uploading | done | failed
  error         String?          @db.Text
}

// ─── Multiplier Bulk Intake (batch upload of many videos) ────────────────────

model MultiplierBatchJob {
  id         String                   @id @default(uuid())
  status     String                   @default("RECEIVING") // RECEIVING | PROCESSING | COMPLETED | FAILED
  namePrefix String?                  // optional "PREFIX 01, 02, …" group naming sequence
  campaignId String?
  styleId    String?
  createdBy  String?
  items      MultiplierBatchJobItem[]
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
}

model MultiplierBatchJobItem {
  id        String             @id @default(uuid())
  jobId     String
  job       MultiplierBatchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fileName  String
  status    String             @default("UPLOADING") // UPLOADING | TRANSCRIBING | GENERATING_HOOKS | READY | FAILED
  groupId   String?            // the auto-created MultiplierGroup
  error     String?            @db.Text
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

// ─── Global Google Drive Connection ──────────────────────────────────────────

model GoogleDriveConnection {
  id                    String    @id @default(uuid())
  purpose               String    @default("multiplier")
  googleEmail           String?
  googleAccessToken     String?   @db.Text
  googleRefreshToken    String?   @db.Text
  googleTokenExpiresAt  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model ClipFolder {
  id             String           @id @default(uuid())
  name           String
  sectionId      String
  section        AccountSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clips          ClipVideo[]
  mixerBatches   ClipMixerBatch[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  parentId       String?
  parent         ClipFolder?      @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  subFolders     ClipFolder[]     @relation("SubFolders")
  clipMixerItems ClipMixerItem[]  @relation("ItemFolder")

  curatorSubmissions CuratorSubmission[]
}

model ClipVideo {
  id        String     @id @default(uuid())
  folderId  String
  folder    ClipFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  videoUrl  String     // Public path to uploaded clip file
  duration  Float      // Duration of the clip in seconds
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ClipMixerBatch {
  id                String           @id @default(uuid())
  folderId          String
  folder            ClipFolder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  trackId           String
  track             Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lyricalTemplateId String
  lyricalTemplate   TrackLyricalTemplate @relation(fields: [lyricalTemplateId], references: [id], onDelete: Cascade)
  targetDuration    Float            @default(15.0)
  trackStart        Float            @default(0.0)
  totalVideos       Int              @default(5)
  muteAudio         Boolean          @default(false)
  status            GenreBatchStatus @default(DRAFT)
  variationStrength Int              @default(3) // 1 to 5 (Phase 4)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  items             ClipMixerItem[]

  tasks             Task[]
}

model ClipMixerItem {
  id                String               @id @default(uuid())
  batchId           String
  batch             ClipMixerBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  accountId         String
  account           ManagedAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lyricalTemplateId String?
  lyricalTemplate   TrackLyricalTemplate? @relation(fields: [lyricalTemplateId], references: [id], onDelete: SetNull)
  renderedVideoUrl  String?
  status            GenreBatchItemStatus @default(PENDING)
  errorMessage      String?
  folderId          String?
  folder            ClipFolder?          @relation("ItemFolder", fields: [folderId], references: [id], onDelete: SetNull)
  
  // Recipe Audit Fields (Phase 4)
  recipeJson        String?              @db.Text
  fingerprint       String?
  
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model StyleTemplate {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  engine      String   // "remotion" | "ffmpeg"
  paramSchema String   @db.Text // JSON schema describing parameters
  thumbnail   String?  @db.Text
  tags        String[] @default([]) // discovery/filtering labels
  source      String   @default("builtin") // "builtin" | "imported" | "ai_draft"
  status      String   @default("published") // "draft" | "published"
  isBase      Boolean  @default(false) // Style Lab base template (drives the auto-generated control panel)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SavedStyle {
  id                  String                 @id @default(uuid())
  templateKey         String
  name                String
  params              String                 @db.Text // JSON parameters values
  layers              Json?                  // null = single-layer legacy style; multi-layer recipes (later phases)
  thumbnail           String?                @db.Text
  family              String                 @default("lyric") // "lyric" | "quote" (Style Lab)
  createdBy           String?
  tags                String[]               // Campaign or niche tags
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  lyricalTemplates    TrackLyricalTemplate[]
  accountGenreConfigs AccountGenreConfig[]
  genreBatchItems     GenreBatchItem[]
}

model StyleRenderJob {
  id           String    @id @default(uuid())
  savedStyleId String
  status       String    // "PENDING" | "PROCESSING" | "COMPLETED" | "FAILED"
  error        String?   @db.Text
  outputUrl    String?   @db.Text
  inputProps   String?   @db.Text // Input JSON props (subtitles, text)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Project {
  id           String          @id @default(uuid())
  name         String
  campaignId   String
  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status       String          @default("ACTIVE") // ACTIVE | PAUSED | DONE
  createdBy    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  
  members      ProjectMember[]
  tasks        Task[]
  chatMessages ChatMessage[]
  activityLogs ActivityLog[]
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectRole String   // LEAD | EDITOR | CURATOR
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, userId])
}

model Task {
  id               String          @id @default(uuid())
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  description      String?         @db.Text
  assigneeId       String?
  assignee         User?           @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  status           String          @default("todo") // todo | doing | review | done
  dueDate          DateTime?
  tags             String[]
  clipMixerBatchId String?
  clipMixerBatch   ClipMixerBatch? @relation(fields: [clipMixerBatchId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  chatMessages     ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  mentions  String[] // user IDs parsed from text
  createdAt DateTime @default(now())
}

model CuratorSubmission {
  id         String      @id @default(uuid())
  campaignId String
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  folderId   String?     // Routes to specific campaign folder/subfolder
  folder     ClipFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  curatorId  String
  curator    User        @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  clipRef    String      // Public uploaded video URL or path
  status     String      @default("pending") // pending | approved | rejected
  feedback   String?     @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String   // e.g., create_project, add_member, create_task, change_status
  target    String   // descriptive target details
  createdAt DateTime @default(now())
}

// ────────────────────────────────────────────────────────
// LMS (Learning Management System)
// ────────────────────────────────────────────────────────

model Course {
  id             String             @id @default(uuid())
  title          String
  description    String?            @db.Text
  assignedRoles  String[]           // role keys that should take this course
  unlocksToolKey String?            // completing this course grants this tool
  status         String             @default("active") // active | archived
  order          Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  sections       Section[]
  lessons        Lesson[]
  enrollments    CourseEnrollment[]
}

model Section {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id             String           @id @default(uuid())
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId      String?
  section        Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  order          Int              @default(0)
  title          String
  youtubeVideoId String           @default("")
  stepsMarkdown  String           @db.Text
  resources      Json             @default("[]") // external resources links/files list
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  progress       LessonProgress[]
  quizQuestions  QuizQuestion[]
}

model LessonProgress {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt     DateTime?
  quizScore       Int?      // number of correct answers if quiz was taken
  watchedPct      Float     @default(0)
  lastPositionSec Float     @default(0)

  @@unique([userId, lessonId])
}

model CourseEnrollment {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      String    @default("assigned") // assigned | in_progress | completed
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, courseId])
}

model QuizQuestion {
  id           String   @id @default(uuid())
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  prompt       String   @db.Text
  options      String[] // answer choices
  correctIndex Int      // 0-based index into options
  createdAt    DateTime @default(now())
}

// ────────────────────────────────────────────────────────
// Agent Layer
// ────────────────────────────────────────────────────────

model AgentAuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instruction String   @db.Text     // original user message
  toolName    String                // which action was called
  toolInput   Json                  // parameters passed
  toolOutput  Json?                 // result returned
  status      String                // success | denied | error | confirmed | pending_confirmation
  createdAt   DateTime @default(now())
}

// ────────────────────────────────────────────────────────
// Lyric Generator
// ────────────────────────────────────────────────────────

model LyricGeneration {
  id              String   @id @default(uuid())
  songQuery       String                    // Original search query "Song - Artist"
  artistName      String?
  trackName       String?

  // Source selection
  lrclibId        Int?                      // LRCLIB track ID selected
  youtubeVideoId  String?                   // YouTube video ID selected
  syncedLyrics    String?  @db.Text         // Raw .lrc content (synced)

  // Line range
  startLine       Int      @default(0)      // 0-indexed start line
  endLine         Int      @default(0)      // 0-indexed end line
  startTime       Float    @default(0.0)    // Derived start timestamp (seconds)
  endTime         Float    @default(0.0)    // Derived end timestamp (seconds)

  // Output
  timedWords      String?  @db.Text         // JSON word-level timing array
  audioFileUrl    String?                   // Local path to trimmed audio
  trackId         String?                   // Link to Track if one was created
  track           Track?   @relation(fields: [trackId], references: [id], onDelete: SetNull)

  // Metadata
  sourceType      String   @default("lrclib") // "lrclib" | "manual_lrc" | "stable_ts"
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ────────────────────────────────────────────────────────
// Data Vault / Sheets for Project Management
// ────────────────────────────────────────────────────────

model VaultFolder {
  id             String              @id @default(uuid())
  name           String
  parentFolderId String?
  parentFolder   VaultFolder?        @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  subFolders     VaultFolder[]       @relation("FolderHierarchy")
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  ownerUserId    String?
  ownerUser      User?               @relation("FolderOwnership", fields: [ownerUserId], references: [id], onDelete: SetNull)
  sheets         Sheet[]
  accessList     VaultFolderAccess[]
}

model VaultFolderAccess {
  id         String      @id @default(uuid())
  folderId   String
  folder     VaultFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId     String?
  roleKey    String?     // User role key (e.g. "curator", "editor", etc.)
  permission String      // "view" | "edit" | "manage"
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([folderId, userId])
  @@unique([folderId, roleKey])
}

model Sheet {
  id         String        @id @default(uuid())
  folderId   String
  folder     VaultFolder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name       String
  frozenRows Int           @default(0)
  frozenCols Int           @default(0)
  colorRules Json?
  viewState  Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  columns    SheetColumn[]
  rows       SheetRow[]
}

model SheetColumn {
  id        String      @id @default(uuid())
  sheetId   String
  sheet     Sheet       @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  type      String      // "text" | "email" | "number" | "url" | "secret" | "date" | "status" | "tags"
  width     Int         @default(150)
  hidden    Boolean     @default(false)
  pinned    Boolean     @default(false)
  config    Json?
  trackConfig Json?
  cells     SheetCell[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([sheetId, name])
}

model SheetRow {
  id            String      @id @default(uuid())
  sheetId       String
  sheet         Sheet       @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  order         Int
  height        Int         @default(34)
  color         String?
  outcomeStatus String?
  outcomeSetAt  DateTime?
  cells         SheetCell[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model SheetCell {
  id             String      @id @default(uuid())
  rowId          String
  row            SheetRow    @relation(fields: [rowId], references: [id], onDelete: Cascade)
  columnId       String
  column         SheetColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  value          String?     @db.Text
  valueEncrypted String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  managedAccountId String?
  managedAccount   ManagedAccount? @relation(fields: [managedAccountId], references: [id], onDelete: SetNull)

  @@unique([rowId, columnId])
}

model VaultAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  action    String   // "reveal" | "edit" | "export" | "import" | "grant" | "revoke"
  target    String   // target details e.g. "Folder: X", "Cell: Y", etc.
  createdAt DateTime @default(now())
}

model AppSetting {
  key   String @id
  value String
}

model AccountGenerationEvent {
  id          String   @id @default(uuid())
  folderId    String
  sheetId     String
  rowId       String
  columnId    String
  ownerUserId String?
  ownerUser   User?    @relation("EventOwnerUser", fields: [ownerUserId], references: [id], onDelete: SetNull)
  status      String   // "success" | "fail"
  occurredAt  DateTime @default(now())
  setByUserId String?
  setByUser   User?    @relation("EventSetByUser", fields: [setByUserId], references: [id], onDelete: SetNull)
}

model FunctionAssignment {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  functionType String    // "generator", "warmup", "scheduler", "editor", "curator"
  startDate    DateTime
  endDate      DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model KpiGoal {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  functionType String    // "generator", "warmup", "scheduler", "editor", "curator"
  period       String    // "day", "week", "month"
  target       Int
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model ActivityEvent {
  id           String         @id @default(uuid())
  userId       String         // The credited employee user
  user         User           @relation("UserActivityEvent", fields: [userId], references: [id], onDelete: Cascade)
  functionType String         // "generator", "warmup", "scheduler", "editor", "curator"
  count        Int            @default(1)
  occurredAt   DateTime       @default(now())
  campaignId   String?
  campaign     Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  source       String         // "auto" | "manual"
  meta         Json?          // arbitrary metadata
  createdBy    String         @default("system") // Can be userId or "system"
  approved     Boolean        @default(true) // Manager approval status
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@index([occurredAt])
}

model WarmupProtocol {
  id           String             @id @default(uuid())
  name         String
  type         String             // "initial" | "maintenance"
  config       Json               // List of initial day protocols: [{day: 1, activeMinutes: 30, posts: 0}] or maintenance params {intervalDays: 2, activeMinutes: 10, posts: 2}
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  enrollments  WarmupEnrollment[]
}

model WarmupEnrollment {
  id                String         @id @default(uuid())
  managedAccountId  String         @unique
  managedAccount    ManagedAccount @relation(fields: [managedAccountId], references: [id], onDelete: Cascade)
  protocolId        String
  protocol          WarmupProtocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  type              String         // "initial" | "maintenance"
  currentDay        Int?           // For initial protocol: current day of 6-day initial ramp (1-6)
  nextDueDate       DateTime       // Zoned next due date/time (stored as UTC timestamp)
  status            String         @default("active") // "active" | "completed" | "paused"
  assignedWarmerId  String?
  assignedWarmer    User?          @relation("WarmerEnrollment", fields: [assignedWarmerId], references: [id], onDelete: SetNull)
  lastActionAt      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([assignedWarmerId])
}


// ═══════════════════════════════════════════════════════════════════════════════
// Music Niche Foundation (Track A) — Drive usage ledger, Video Factory,
// overlay cache, delivery/confirmation tracking, self-hosted font registry
// ═══════════════════════════════════════════════════════════════════════════════

/// Usage ledger for files in a Drive source folder.
/// Names-only sync — files are never downloaded by the ledger.
/// accountId is null for shared folders (pasted per-batch in the Video Factory);
/// the ledger works per-folder, ownership by an account is only a legacy tag.
model DriveFile {
  id          String          @id @default(uuid())
  accountId   String?
  account     ManagedAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folderId    String
  driveFileId String
  name        String
  size        BigInt?
  mimeType    String?
  timesUsed   Int            @default(0)
  lastUsedAt  DateTime?
  status      String         @default("unused") // unused | used | missing
  addedAt     DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([folderId, driveFileId])
  @@index([accountId, timesUsed])
}

model FactoryBatch {
  id                String   @id @default(uuid())
  name              String
  mode              String   // lyric | quote
  mixingEnabled     Boolean  @default(false)
  variationStrength Int      @default(3) // 1-5
  targetDuration    Float    @default(30)
  campaignId        String?
  styleIds          String[]
  // Source of background clips. Legacy single-folder column kept for
  // back-compat; the arrays below are authoritative.
  sourceFolderId    String?
  // "folders" = one or more pasted Drive folders; "accounts" = the input
  // folders of the listed accounts. Either way, sourceFolderIds holds the
  // UNION of folder ids used for pooling (resolved at createBatch time).
  sourceMode        String   @default("folders") // folders | accounts
  sourceFolderIds   String[] @default([])
  sourceAccountIds  String[] @default([])
  // Quote mode: optional background music bed (local public path or R2 key).
  musicAudioRef     String?
  // Content pool — lyric mode: Track ids (round-robin, Track.maxReuse respected);
  // quote mode: quote texts (round-robin).
  trackIds          String[] @default([])
  quotes            String[] @default([])
  status            String   @default("DRAFT") // DRAFT | QUEUED | RENDERING | COMPLETED | FAILED
  // Operator-facing failure reason (e.g. "Canceled by operator").
  errorMessage      String?  @db.Text
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  items             FactoryBatchItem[]
}

model FactoryBatchItem {
  id                 String       @id @default(uuid())
  batchId            String
  batch              FactoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  accountId          String?
  styleId            String?
  trackId            String?
  track              Track?       @relation(fields: [trackId], references: [id], onDelete: SetNull)
  quoteText          String?      @db.Text
  recipe             Json?
  recipeFingerprint  String?
  sourceDriveFileIds String[]
  status             String       @default("PENDING") // PENDING | RENDERING | COMPLETED | FAILED | CANCELED
  outputRef          String?
  outputDriveFileId  String?
  // Render-first / distribute-later: null until a distribute run assigns this
  // item to an account and uploads it to that account's output Drive folder.
  distributedAt          DateTime?
  distributedToAccountId String?
  error              String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([batchId, status])
}

model OverlayCache {
  id        String    @id @default(uuid())
  hash      String    @unique // SHA-256 of style+params+lyrics/quote
  styleId   String?
  trackId   String?
  filePath  String?   // local
  r2Key     String?
  readyAt   DateTime?
  createdAt DateTime  @default(now())
}

model Delivery {
  id             String   @id @default(uuid())
  accountId      String
  campaignId     String?
  batchId        String?  // FactoryBatch id (plain string, no FK)
  videoCount     Int
  fileList       Json     @default("[]")
  deliveredAt    DateTime @default(now())
  outputFolderId String?
  status         String   @default("delivered") // delivered | scheduled | posted
  postingMode    String   @default("manual")    // manual | auto_schedule | auto_post
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  confirmation   DeliveryConfirmation?

  @@index([campaignId, deliveredAt])
  @@index([accountId, status])
}

model DeliveryConfirmation {
  id          String   @id @default(uuid())
  deliveryId  String   @unique
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  scheduledAt DateTime?
  scheduledBy String?
  postedCount Int?
  postedAt    DateTime?
  postedBy    String?
  note        String?  @db.Text
}

model FontAsset {
  id        String  @id @default(uuid())
  family    String  @unique
  weights   Int[]   // weights actually on disk
  files     Json    // { "400": "fonts/inter/Inter-Regular.ttf", ... }
  license   String
  isDefault Boolean @default(false)
}

// ═══════════════════════════════════════════════════════════════════════════════
// Campaign Link Capture + 24h Analytics Refresh (Apify)
// ═══════════════════════════════════════════════════════════════════════════════

/// A TikTok video linked back to a published PostJob via Apify profile scrape.
/// Unresolved rows use a placeholder tiktokVideoId ("unresolved_<postJobId>")
/// so a later successful capture can UPDATE the row instead of duplicating it.
model TrackedVideo {
  id             String   @id @default(uuid())
  tiktokVideoId  String   @unique
  url            String
  accountId      String
  campaignId     String?
  postJobId      String?
  publishedAt    DateTime
  capturedAt     DateTime @default(now())
  captureMethod  String   // "recent_match" (apify only)
  confidence     String   @default("high") // high | medium | low
  status         String   @default("captured") // captured | unresolved | unavailable
  captureAttempts Int     @default(0) // capture retry count — drives 1h/6h/24h backoff
  views          BigInt   @default(0)
  likes          BigInt   @default(0)
  comments       BigInt   @default(0)
  shares         BigInt   @default(0)
  lastRefreshedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  snapshots      VideoStatSnapshot[]
  @@index([campaignId])
  @@index([accountId])
  @@index([status, lastRefreshedAt])
}

model VideoStatSnapshot {
  id             String   @id @default(uuid())
  trackedVideoId String
  trackedVideo   TrackedVideo @relation(fields: [trackedVideoId], references: [id], onDelete: Cascade)
  views          BigInt
  likes          BigInt
  comments       BigInt
  shares         BigInt
  recordedAt     DateTime @default(now())
  @@index([trackedVideoId, recordedAt])
}

model AnalyticsRun {
  id         String   @id @default(uuid())
  type       String   // "daily" | "manual" | "capture"
  status     String   @default("running") // running | done | failed
  attempted  Int      @default(0)
  succeeded  Int      @default(0)
  failed     Int      @default(0)
  skipped    Int      @default(0)
  cursor     String?  // resumable progress marker
  error      String?  @db.Text
  startedAt  DateTime @default(now())
  finishedAt DateTime?
}

// ═══════════════════════════════════════════════════════════════════════════════
// Client-facing campaign tracking share links
// ═══════════════════════════════════════════════════════════════════════════════

/// A share code grants read-only public access to a campaign's tracking stats
/// via /track#<code>. The code itself is the secret — stored in plain text so
/// it can be displayed/copied in the internal UI. Revoke instead of delete.
model CampaignShare {
  id         String    @id @default(uuid())
  campaignId String
  code       String    @unique
  label      String?
  createdBy  String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  @@index([campaignId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Client API keys — one key per CLIENT, granted access to many campaigns.
// The client swaps the campaignId in the URL; their key never changes.
// Raw keys are shown once at creation; only the SHA-256 hash is stored.
// ═══════════════════════════════════════════════════════════════════════════════

model ApiClient {
  id        String              @id @default(uuid())
  name      String
  notes     String?
  createdAt DateTime            @default(now())
  revokedAt DateTime?
  keys      ApiClientKey[]
  campaigns ApiClientCampaign[]
}

model ApiClientKey {
  id         String    @id @default(uuid())
  clientId   String
  client     ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  keyHash    String    @unique
  keyPrefix  String // first ~12 chars, for identification in the UI ("slk_Ab3X9…")
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  @@index([clientId])
}

model ApiClientCampaign {
  id         String    @id @default(uuid())
  clientId   String
  client     ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaignId String // plain column, no FK (matches CampaignShare pattern)
  createdAt  DateTime  @default(now())
  @@unique([clientId, campaignId])
  @@index([campaignId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Bulk Link Sourcing — paste TikTok links → yt-dlp download → Drive distribution
// ═══════════════════════════════════════════════════════════════════════════════

model SourcingRun {
  id         String   @id @default(uuid())
  createdBy  String?
  createdAt  DateTime @default(now())
  linkCount  Int      @default(0)
  status     String   @default("DOWNLOADING") // DOWNLOADING | READY | DISTRIBUTING | DONE | FAILED
  summary    Json     @default("{}")
  videos     SourcedVideo[]
}

model SourcedVideo {
  id          String   @id @default(uuid())
  runId       String
  run         SourcingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceUrl   String
  normalizedUrl String
  status      String   @default("queued") // queued | downloading | downloaded | failed | assigned | uploaded
  localPath   String?
  durationSec Float?
  sizeBytes   BigInt?
  meta        Json     @default("{}") // { author, title, resolution }
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assignments SourcedVideoAssignment[]
  @@index([normalizedUrl])
  @@index([runId, status])
}

model SourcedVideoAssignment {
  id             String   @id @default(uuid())
  sourcedVideoId String
  sourcedVideo   SourcedVideo @relation(fields: [sourcedVideoId], references: [id], onDelete: Cascade)
  accountId      String
  driveFolderId  String
  driveFolderName String?
  driveFileId    String?
  status         String   @default("queued") // queued | uploading | uploaded | failed
  uploadedAt     DateTime?
  error          String?  @db.Text
  createdAt      DateTime @default(now())
  @@index([sourcedVideoId])
  @@index([accountId])
}
