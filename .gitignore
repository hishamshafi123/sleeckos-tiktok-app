# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
dev.db

# local Python / environment files
/venv
# Flat font TTFs are runtime-downloaded cache (see Dockerfile / composer.ts),
# but the bundled per-family statics below ARE committed (self-hosted font set).
/public/fonts/*
!/public/fonts/inter/
!/public/fonts/ibmplexsans/
!/public/fonts/archivo/
!/public/fonts/barlow/
!/public/fonts/barlowcondensed/
!/public/fonts/oswald/
!/public/fonts/anton/
!/public/fonts/publicsans/
!/public/fonts/librefranklin/
!/public/fonts/sourcesans3/
/scratch
/public/uploads
/scripts/__pycache__
*.pyc


# Local screenshot drop folder
kimi image input/
kimi input/
