# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production

# Port the app listens on (also update nginx proxy_pass to match). Default: 3000
PORT=3000

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Used by both the cron routes and the host crontab entries.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-openssl-rand-hex-32

# Shared secret for the Multilogin Phone Guardian daemon. Generate with: openssl rand -hex 32
GUARDIAN_INTEGRATION_SECRET=

# ── Postgres ─────────────────────────────────────────────────────────────────
# These are used by the docker-compose db service AND the DATABASE_URL below.
POSTGRES_USER=sleeckos
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=sleeckos

# DATABASE_URL is constructed automatically by docker-compose from the vars above.
# Only set this manually if running outside docker-compose (e.g. local prisma studio).
# DATABASE_URL=postgresql://sleeckos:replace-with-strong-password@db:5432/sleeckos

# ── Runtime / Docker resources (KVM8 defaults) ────────────────────────────────
# One app container runs Next.js and all workers; do not add replicas.
# Changes require recreating the app/db containers (see DEPLOYMENT.md).
APP_CPU_LIMIT=7.0
APP_MEM_LIMIT=12g
DB_CPU_LIMIT=1.0
DB_MEM_LIMIT=1g

# Worker parallelism inside the single app container.
RENDER_CONCURRENCY=4
FFMPEG_THREADS=2
REMOTION_STILL_CONCURRENCY=3
TRANSCRIBE_CONCURRENCY=2
EXPORT_WORKER_CONCURRENCY=8

# KVM4 rollback values (replace the settings above, then recreate containers):
# APP_CPU_LIMIT=3.5
# APP_MEM_LIMIT=6g
# DB_CPU_LIMIT=0.5
# DB_MEM_LIMIT=512m
# RENDER_CONCURRENCY=2
# FFMPEG_THREADS=2
# REMOTION_STILL_CONCURRENCY=2
# TRANSCRIBE_CONCURRENCY=2
# EXPORT_WORKER_CONCURRENCY=4

#── TikTok ───────────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Google ───────────────────────────────────────────────────────────────────
# Full JSON content of the service account key (single line, JSON-encoded string).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── YouTube ──────────────────────────────────────────────────────────────────
# YouTube Data API v3 key for video sourcing. Get from Google Cloud Console.
YOUTUBE_API_KEY=

# ── TikLiveAPI (primary analytics provider — cheap per-request pricing) ──────
# API key from https://www.tikliveapi.com — used for all TikTok stats fetches
# (sweep, refresh, capture, spot-check). Apify below is the automatic fallback
# when TikLive fails. Leave empty to run Apify-only.
TIKLIVE_API_KEY=
# TIKLIVE_TIMEOUT_MS=30000
# TIKLIVE_MIN_INTERVAL_MS=350      min spacing between calls (~170 req/min)
# TIKLIVE_COST_PER_CALL=0.000099   estimated USD/request for the spend ledger

# ── Apify (fallback analytics provider) ──────────────────────────────────────
# API token from https://console.apify.com/account/integrations.
# Powers clockworks/tiktok-scraper runs for campaign video tracking when
# TikLiveAPI is unavailable or unconfigured.
# Leave empty to disable tracking (posting is unaffected either way).
APIFY_TOKEN=

# Daily account sweep (cron /api/cron/account-sweep) — one Apify profile call
# per active account per day; captures links for recent posts + refreshes stats.
# SWEEP_LOOKBACK_DAYS=7   accounts/jobs considered active
# SWEEP_MAX_VIDEOS=20     latest videos fetched per account (default 20)
# SWEEP_SLEEP_MS=500      pause between account calls

# Instant per-post link capture after each confirmed publish (one Apify call
# per post). Off by default — the daily sweep is the primary capture path.
# CAPTURE_ON_PUBLISH=false
